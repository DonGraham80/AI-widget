{
  "name": "Contact Form",
  "description": "Collects a contact request",
  "form": {
    "submitTo": "/api/contact",
    "method": "POST"
  },
  "fields": {
    "name": {
      "label": "Full name",
      "type": "string",
      "prompt": "What is your full name?",
      "required": true
    },
    "email": {
      "label": "Email",
      "type": "string",
      "prompt": "What is your email address?",
      "required": true,
      "validation": {
        "pattern": ".+@.+"
      }
    },
    "message": {
      "label": "Message",
      "type": "string",
      "prompt": "What message do you want to send?",
      "required": false
    }
  },
  "ui": {
    "greeting": "Hi! I can fill this form for you."
  }
}
